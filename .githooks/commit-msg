#!/bin/sh
# Recusa mensagens de commit fora do padrão do projeto (veja "Commits" em AGENTS.md).
# Ativar em um clone novo: git config core.hooksPath .githooks

first=$(head -n1 "$1")

case "$first" in
  "Merge "*|"Revert \""*) exit 0 ;;
esac

if ! printf '%s\n' "$first" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [^ ].*[^.]$'; then
  echo "Commit recusado: a primeira linha precisa seguir Conventional Commits." >&2
  echo "  formato:  <tipo>(<escopo opcional>): <descrição>   sem ponto final" >&2
  echo "  tipos:    feat fix docs style refactor perf test build ci chore revert" >&2
  echo "  exemplo:  feat(icons): adiciona ícone de impressora" >&2
  exit 1
fi

if grep -qiE '^co-authored-by:.*(claude|anthropic|copilot|gemini|openai|codex|cursor)' "$1" || grep -qiE 'generated with .*(claude|copilot|gemini|codex)' "$1"; then
  echo "Commit recusado: este repositório não registra IA como coautora." >&2
  echo "  Remova a linha Co-Authored-By ou a assinatura da ferramenta." >&2
  exit 1
fi
